# Copy to .env.local (git-ignored). These values are public: they end up in the browser build.
# Never put a secret here.

# "mock" (default): in-memory fake data, no backend needed.
# "real": Supabase. Needs the two values below.
VITE_SERVICES=mock

# Local Supabase: `npm run db:start`, then `npx supabase status` shows the URL and the publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Used by the Content-Security-Policy at build time (see scripts/build-headers.mjs).
VITE_API_URL=
VITE_MEDIA_URL=
VITE_R2_ACCOUNT_ID=

# Locally (`npm run worker:dev`): VITE_API_URL=http://localhost:8787 and VITE_MEDIA_URL=http://localhost:8787/media

# Analytics and marketing (milestone B8). Everything below is optional. Nothing loads before the visitor allows it.
# local | staging | production: sent as the `env` property on every analytics event.
VITE_APP_ENV=local
# PostHog EU project key (public). Empty = no browser analytics.
VITE_POSTHOG_KEY=
# Share of consenting sessions that are recorded (0 to 1). 0.2 stays under 5,000 recordings a month up to ~25,000 sessions.
VITE_POSTHOG_RECORDING_SAMPLE=0.2
# Advertising pixels. Empty = not loaded, and the Content-Security-Policy does not mention them.
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ID=
