{
  "name": "kollide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run cn && tsc -b && vite build && node scripts/build-headers.mjs",
    "cn": "cn build --content \"src/**/*.{ts,tsx}\" -o src/lib/cn-tables.ts -q",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:rls": "bash scripts/check-rls.sh",
    "db:types": "mkdir -p src/types && supabase gen types typescript > src/types/database.ts",
    "worker:dev": "npm --prefix workers/api run dev",
    "worker:test": "npm --prefix workers/api test",
    "worker:typecheck": "npm --prefix workers/api run typecheck",
    "e2e": "playwright test",
    "db:race": "bash scripts/test-concurrency.sh",
    "db:restore-test": "bash scripts/restore-test.sh",
    "check:bundle": "node scripts/check-bundle-secrets.mjs dist",
    "check:dns": "node scripts/check-dns.mjs",
    "load:join": "node scripts/load-join.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "posthog-js": "^1.447.15",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
