{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "magicui": {
      "command": "npx",
      "args": [
        "-y",
        "@magicuidesign/mcp@latest"
      ]
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ]
    },
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    },
    "beui": {
      "type": "http",
      "url": "https://mcp.beui.dev/mcp"
    },
    "motion-brew": {
      "type": "http",
      "url": "https://motion-brew.com/mcp"
    },
    "motionprompts": {
      "type": "http",
      "url": "https://motionprompts.dev/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath=/opt/pw-browsers/chromium",
        "--headless=true",
        "--isolated=true",
        "--chromeArg=--no-sandbox",
        "--no-usage-statistics"
      ]
    }
  }
}
